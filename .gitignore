# build-env: собственный изолированный build environment XrOS
# (Arch-rootfs, кэш пакетов, bootstrap-тарболл, логи — вне git)
build-env/

# Сборка и артефакты (не коммитим — пересобираются из исходников)
# out/: готовые ISO и логи сборки
out/
# work/: рабочие каталоги mkarchiso
work/
# experiments/: QEMU-прогоны — логи, скриншоты, образы дисков
experiments/
*.iso
*.img
*.log
__pycache__/
*.pyc
# Локальные бэкапы ISO/rootfs (вне git, только в ~/workspace/xros-backups)
*.qcow2
# build-staging: копия Diamond в packages/ пересоздаётся шагом 5 build.sh
packages/xros-installer/xros-installer-diamond/
# tools-debs/: .deb для восстановления хоста после перезагрузок (не исходники проекта)
tools-debs/
# website/: сайт XrOS — отдельный артефакт, ведётся в side-chat
website/
