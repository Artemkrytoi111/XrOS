# build-env: собственный изолированный build environment XrOS
build-env/         # Arch-rootfs, кэш пакетов, bootstrap-тарболл, логи (вне git)

# Сборка и артефакты (не коммитим — пересобираются из исходников)
out/               # готовые ISO и логи сборки
work/              # рабочие каталоги mkarchiso
experiments/       # QEMU-прогоны: логи, скриншоты, образы дисков
*.iso
*.img
*.log
__pycache__/
*.pyc
target/            # выход cargo
# Выход makepkg: в git хранится только копия в repo/ (её кладёт build.sh)
packages/*/*.pkg.tar.zst
# Резервные копии БД от repo-add
*.db.tar.gz.old
*.files.tar.gz.old
