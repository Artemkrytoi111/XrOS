#!/usr/bin/env bash
# xros-auto-update — автоматическое обновление XrOS.
#
# Запускается systemd-юнитом xros-auto-update.service по таймеру
# xros-auto-update.timer (ежедневно + через 15 минут после загрузки).
# Таймер нигде не включён по умолчанию: в живой системе скрипт ничего
# не делает (см. защиту ниже), в установленной системе таймер включает
# установщик xros-install — отдельным шагом, после GPG-подписи [xros]
# (см. A-04, docs/REPO-PUBLISHING.md §2.6).
#
# Порядок работы:
#   1. Защита от живой системы: маркеры archiso (/run/archiso/bootmnt,
#      /run/archiso/airootfs) — в живой системе выход 0, ничего не
#      делаем. Живая система эфемерна: обновлять её бессмысленно
#      (запись уходит в RAM) и вредно (pacman -Syu в live-среде может
#      сломать работающую сессию установки).
#   2. pacman -Sy — обновление баз всех репозиториев, включая [xros].
#   3. Сначала обновления безопасности из [xros]: уже установленные
#      пакеты репозитория xros обновляются отдельно, чтобы исправления
#      безопасности ставились, даже если полное обновление системы
#      потом упрётся в конфликт.
#   4. Затем полное обновление системы: pacman -Su.
#
# Ошибки:
#   * Нет сети / не удалось синхронизировать базы / база pacman
#     заблокирована другим процессом — ВРЕМЕННО: пишем в журнал
#     и выходим с кодом 0, таймер повторит при следующем запуске.
#     Сервис не помечается failed, система не «падает».
#   * Ошибка проверки подписи пакетов — НЕ временная: выход 1,
#     сервис failed, это видно в журнале и требует внимания.
#     Подписи [xros] проверяются и при SigLevel=Optional:
#     подписанные пакеты проверяются, неподписанные принимаются
#     (см. A-04).
#   * Прочие ошибки pacman — выход 1.
#
# Логи: stdout/stderr сервиса попадают в журнал systemd
# (journalctl -u xros-auto-update.service); дополнительно дублируем
# через logger, если он есть.
# Ручной запуск: sudo /usr/local/bin/xros-auto-update
set -u

log() {
  printf '%s xros-auto-update: %s\n' "$(date '+%F %T')" "$*"
  logger -t xros-auto-update "$*" 2>/dev/null || true
}

# Живая система? Те же маркеры, что и в xros-install.
is_live() {
  [[ -d /run/archiso/bootmnt || -f /run/archiso/airootfs/etc/os-release ]]
}

# Временная ошибка (сеть/синхронизация/блокировка базы)? Вывод pacman
# передаётся как аргумент; 0 — временная, 1 — нет.
is_transient() {
  grep -qiE 'failed to synchronize all databases|не удалось синхронизировать|could not resolve host|temporary failure in name resolution|failed to retrieve some files|не удалось получить некоторые файлы|failed to lock database|не удалось заблокировать|database is locked|network is unreachable|недоступна сеть|connection (timed out|refused)|error: failed retrieving file|no servers configured|серверы не настроены' <<<"$1"
}

# Ошибка проверки подписи? 0 — да, 1 — нет.
is_signature_error() {
  grep -qiE 'signature|invalid or corrupted|недействител|поврежд[её]н' <<<"$1"
}

# Выполнить pacman, классифицировать сбой. $1 — описание шага,
# остальные аргументы — команда pacman. 0 — успех или временный сбой
# (уже залогирован, повтор — при следующем запуске таймера),
# 1 — ошибка подписи или прочая ошибка pacman.
run_pacman() {
  local what="$1"; shift
  local out rc
  out="$("$@" 2>&1)" && rc=0 || rc=$?
  if [[ $rc -eq 0 ]]; then
    log "$what: OK"
    return 0
  fi
  log "$what: ОШИБКА (код $rc): $(head -n 3 <<<"$out" | tr '\n' ' ')"
  if is_signature_error "$out"; then
    log "$what: ошибка проверки подписи пакетов — требуется вмешательство, автообновление остановлено"
    return 1
  fi
  if is_transient "$out"; then
    log "$what: временная ошибка (сеть/синхронизация/блокировка) — повтор при следующем запуске таймера"
    return 0
  fi
  log "$what: ошибка pacman — требуется вмешательство, автообновление остановлено"
  return 1
}

main() {
  if is_live; then
    log "живая система (archiso) — автообновление не выполняется"
    return 0
  fi
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    log "ОШИБКА: нужен root (запускайте через sudo или systemd)"
    return 1
  fi
  if [[ -e /var/lib/pacman/db.lck ]]; then
    log "база pacman заблокирована другим процессом — повтор при следующем запуске таймера"
    return 0
  fi

  # Проверяем, что репозиторий [xros] требует подписи — иначе автообновление
  # может поставить неподписанный/поддельный пакет. Fail-closed.
  if ! awk '
    /^\[xros\]$/ { in_xros=1; next }
    /^\[/ { in_xros=0 }
    in_xros && /^[[:space:]]*SigLevel[[:space:]]*=[[:space:]]*Required([[:space:]]|$)/ { found=1 }
    END { exit(found ? 0 : 1) }
  ' /etc/pacman.conf; then
    log "ОШИБКА: в pacman.conf SigLevel для [xros] не Required — автообновление отключено для безопасности"
    return 1
  fi

  # Шаг 1: обновление баз (все репозитории, включая [xros]).
  run_pacman "обновление баз (pacman -Sy)" pacman -Sy || return 1

  # Шаг 2: сначала обновления безопасности из [xros] — только уже
  # установленные пакеты этого репозитория (--needed не ставит новое).
  local xros_pkgs=""
  xros_pkgs="$(pacman -Sl xros 2>/dev/null | awk '$1 == "xros" && $0 ~ /\[installed/ {print $2}' | tr '\n' ' ')" || true
  if [[ -n "${xros_pkgs// }" ]]; then
    # shellcheck disable=SC2086
    run_pacman "обновления безопасности [xros]" pacman -S --noconfirm --needed $xros_pkgs || return 1
  else
    log "обновления безопасности [xros]: установленных пакетов [xros] нет — шаг пропущен"
  fi

  # Шаг 3: полное обновление системы.
  # Фаза 5B (ротация production-ключа): переходный пакет xros-keyring
  # НЕ ставится автоматически — pacman -Su обновляет только уже
  # установленные пакеты, а xros-keyring новый. Поэтому включаем его
  # явной целью ПОЛНОГО обновления (pacman -Su xros-keyring). Это полное
  # обновление, а не частичная транзакция (pacman -Sy + установка
  # одного пакета запрещена). После установки xros-keyring его
  # post_install импортирует и локально подписывает новый ключ.
  #
  # Фаза 5.1: условие — ДОВЕРИЕ новому ключу, а не наличие пакета.
  # Pacman записывает пакет в локальную базу как установленный ДАЖЕ при
  # ошибке post_install (доказано Фазой 5.1: pacman -Q показывает пакет,
  # а новый ключ в keyring отсутствует). Поэтому `pacman -Q xros-keyring`
  # НЕ доказывает, что переход выполнен, и старый updater молча пропускал
  # переход при упавшем post_install. Проверяем доверие напрямую по
  # ожидаемому отпечатку нового production-ключа. Отпечаток захардкожен
  # намеренно: извлекать его из файла ключа пакета ненадёжно — при
  # повреждённом пакете файл может содержать ДРУГОЙ ключ (например,
  # старый), чей отпечаток тоже доверен, и проверка дала бы ложный PASS.
  # Если ключ НЕ доверен — включаем пакет явной целью: первичная
  # установка (пакета нет) или ПЕРЕУСТАНОВКА (пакет есть, но post_install
  # упал или локальная подпись потеряна). Доказано Фазой 5.1: pacman -Su
  # xros-keyring переустанавливает пакет той же версии и заново запускает
  # post_install, восстанавливая доверие. Если ключ уже доверен —
  # переход выполнен, пакет не нужен (даже если он не установлен:
  # ключ мог быть импортирован вручную).
  local new_fpr="9E71EDB1A341779B7F0B99EAD1A3963AA4E45CEB"
  local key_trusted=0
  if pacman-key --list-keys "$new_fpr" 2>/dev/null | grep -q "\[ *full *\]"; then
    key_trusted=1
  fi
  local su_target=()
  if [[ "$key_trusted" -eq 0 ]] && pacman -Si xros-keyring >/dev/null 2>&1; then
    if pacman -Q xros-keyring >/dev/null 2>&1; then
      log "полное обновление системы (pacman -Su): новый ключ не доверен — будет ПЕРЕУСТАНОВЛЕН переходный пакет xros-keyring (восстановление доверия)"
    else
      log "полное обновление системы (pacman -Su): будет установлен переходный пакет xros-keyring"
    fi
    su_target=(xros-keyring)
  fi
  run_pacman "полное обновление системы (pacman -Su)" pacman -Su --noconfirm "${su_target[@]}" || return 1

  log "автообновление завершено"
  return 0
}

main "$@"
