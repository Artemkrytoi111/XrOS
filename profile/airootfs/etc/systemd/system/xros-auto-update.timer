[Unit]
Description=Ежедневное автообновление XrOS (репозиторий [xros] + система)

[Timer]
# Через 15 минут после загрузки (сеть уже поднята) и далее раз в сутки.
OnBootSec=15min
OnCalendar=daily
# Если машина была выключена в момент срабатывания — наверстать
# при следующем запуске (пропущенное обновление не теряется).
Persistent=true
# Разброс до 45 минут, чтобы все машины не ломились на сервер разом.
RandomizedDelaySec=45min

[Install]
WantedBy=timers.target
