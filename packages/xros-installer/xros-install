#!/usr/bin/env bash
# XrOS — установщик (консольный, bash+dialog).
# Работает из живой системы XrOS: размечает диск, копирует систему,
# ставит GRUB, создаёт пользователя.
#
# Два режима:
#  * интерактивный (по умолчанию) — диалоги dialog;
#  * неинтерактивный — для графического установщика (xros-install-gui):
#    XROS_NONINTERACTIVE=1 xros-install
#    Конфиг создаётся GUI в закрытом каталоге /run/xros-install как
#    KEY='value' (права 600) и удаляется установщиком после чтения.
#    Значения: DISK, PARTMODE (erase|manual), ROOT_PART, EFI_PART,
#    FS (ext4|btrfs|xfs), HOSTNAME, FULLNAME, USERNAME, USERPASS,
#    ROOTPASS, AUTOLOGIN (0|1), TIMEZONE, KEYMAP, DE, OFFICE.
#    Прогресс в неинтерактивном режиме пишется в stdout в формате
#    dialog-gauge (число = процент, XXX = сообщение) и в журнал runtime-каталога.
set -u -o pipefail
# SIGPIPE игнорим: в неинтерактивном режиме stdout — труба в GUI, и echo
# в мёртвую трубу убивал движок до конца очистки ($TARGET оставался
# смонтированным: ловушка EXIT стартовала, но сама очистка тоже пишет
# в stdout и умирала на полпути). С игнором записи падают с EPIPE,
# очистка завершается, а say() всё равно пишет строки в журнал.
trap '' PIPE
# umask 077: журнал установки и любые файлы, создаваемые движком,
# не должны быть читаемы другими пользователями (в конфиге — пароли).
umask 077
export LC_ALL=C.UTF-8
export LANG=ru_RU.UTF-8

TITLE="XrOS 1.0 — Установщик"
BACKTITLE="XrOS  •  на базе Arch Linux"
TARGET="/mnt/xros-install"
RUNTIME_DIR="/run/xros-install"
LOG="$RUNTIME_DIR/xros-install.log"
CONF="$RUNTIME_DIR/xros-install.conf"
DE_RESULT_FILE="$RUNTIME_DIR/xros-de-result"
# Runtime-каталог создаётся только после перевыполнения через sudo.
# Его владелец и права проверяются до любых записей root-процессом.

BANNER=$(cat /usr/share/xros/banner.txt 2>/dev/null || echo "XrOS 1.0")

say() { echo "[xros-install] $*" | tee -a "$LOG"; }

# shellcheck disable=SC2069
dlg() { dialog --backtitle "$BACKTITLE" --title "$TITLE" --colors "$@" 2>&1 >/dev/tty; }

NONINTERACTIVE="${XROS_NONINTERACTIVE:-}"

if [[ $EUID -ne 0 ]]; then
  # Живая система работает под пользователем xros с passwordless sudo —
  # установщик сам поднимает права, пароль не спрашивает.
  if command -v sudo >/dev/null 2>&1; then
    # --preserve-env: без него sudo стирает XROS_NONINTERACTIVE и
    # XROS_INSTALL_CONF, и GUI-режим молча превращался бы в интерактивный.
    exec sudo --preserve-env=XROS_NONINTERACTIVE,XROS_INSTALL_CONF "$0" "$@"
  else
    echo "Запустите установщик от root: sudo xros-install"
    exit 1
  fi
fi
# Runtime-каталог принадлежит root и закрыт от остальных пользователей.
# GUI создаёт его заранее через штатный privileged launcher; движок
# отказывается работать с подменённым каталогом или файлами.
if [[ -L "$RUNTIME_DIR" || ( -e "$RUNTIME_DIR" && ! -d "$RUNTIME_DIR" ) ]]; then
  echo "ОШИБКА: небезопасный runtime-каталог"; exit 1
fi
if [[ ! -d "$RUNTIME_DIR" ]]; then
  install -d -m 700 -o root -g root "$RUNTIME_DIR"
fi
if [[ ! -O "$RUNTIME_DIR" || ! -w "$RUNTIME_DIR" \
   || "$(stat -c '%u:%a' "$RUNTIME_DIR" 2>/dev/null || true)" != "0:700" ]]; then
  echo "ОШИБКА: небезопасный runtime-каталог"; exit 1
fi
if [[ -L "$LOG" ]]; then
  echo "ОШИБКА: небезопасный файл журнала"; exit 1
fi
if [[ -e "$LOG" && ! -f "$LOG" ]]; then
  echo "ОШИБКА: небезопасный файл журнала"; exit 1
fi
if [[ -e "$LOG" && ! -O "$LOG" ]]; then
  echo "ОШИБКА: чужой файл журнала"; exit 1
fi
(umask 077; : > "$LOG") || { echo "ОШИБКА: не удалось создать журнал"; exit 1; }
chmod 600 "$LOG"
if [[ -L "$DE_RESULT_FILE" || ( -e "$DE_RESULT_FILE" && ! -f "$DE_RESULT_FILE" ) ]]; then
  echo "ОШИБКА: небезопасный файл результата"; exit 1
fi
rm -f -- "$DE_RESULT_FILE"
if [[ ! -d /run/archiso/bootmnt && ! -f /run/archiso/airootfs/etc/os-release ]]; then
  if [[ -z "$NONINTERACTIVE" ]]; then
    dialog --backtitle "$BACKTITLE" --title "$TITLE" --msgbox "Внимание: это не похоже на живую систему XrOS.\nУстановка будет копировать текущую систему (/)." 10 60
  else
    say "ВНИМАНИЕ: это не похоже на живую систему XrOS"
  fi
fi

# --- XROS: защита дочернего процесса (начало) ---
# При извлечении этого блока тестовыми harness-ами верхние константы
# отсутствуют; production-путь уже задан выше и не меняется.
RUNTIME_DIR="${RUNTIME_DIR:-/tmp}"
CONF="${CONF:-$RUNTIME_DIR/xros-install.conf}"
DE_RESULT_FILE="${DE_RESULT_FILE:-$RUNTIME_DIR/xros-de-result}"
# Движок — дочерний процесс графического установщика. Если GUI умирает
# (падение, kill извне), движок НЕ должен продолжать форматирование /
# копирование системы без интерфейса. GUI страхует это с двух сторон
# (см. src/xros-install-gui-rs/src/install.rs):
#  * PR_SET_PDEATHSIG: ядро шлёт нам SIGTERM, как только умирает родитель;
#  * отдельная группа процессов (setsid): при штатной отмене GUI шлёт
#    SIGTERM всей группе, гася и rsync / arch-chroot / mkfs.
# Здесь — вторая половина договора: по SIGHUP/SIGTERM/SIGINT
# останавливаемся, гасим своих потомков, размонтируем $TARGET,
# удаляем временные файлы и пишем причину остановки в журнал.
# Ловушки ставятся ПОСЛЕ перевыполнения через sudo выше: exec
# сбрасывает ловушки, поэтому ставить их раньше бессмысленно.
XROS_CLEANUP_DONE=0
XROS_STOP_REASON=""
# Флаг «идёт установка»: ставится в начале run_install, снимается
# только на успешном пути. Нужен ловушке EXIT (ниже): чистить надо
# только при обрыве во время установки, а не при любом выходе
# (например, при ранней ошибке валидации конфига чистить нечего).

# Печатает pid всех потомков перечисленных pid (дети, внуки, ...).
# ps --ppid находит только прямых детей, а arch-chroot прячет за собой
# ещё один bash, поэтому идём по дереву, пока есть кого искать.
xros_descendants() {
  local frontier="$1" next pid kids out=""
  frontier=$(printf '%s' "$frontier" | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true)
  while [[ -n "$frontier" ]]; do
    next=""
    for pid in $frontier; do
      kids=$(ps -o pid= --ppid "$pid" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true)
      for k in $kids; do
        [[ "$k" == "$$" ]] && continue
        out="$out $k"
        next="$next $k"
      done
    done
    frontier="$next"
  done
  printf '%s' "$out"
}

# Все процессы своей группы, кроме себя. Нужна для внуков, чей
# родитель уже умер: они переродительствованны, и ps --ppid
# их больше не находит.
xros_group_members() {
  ps -eo pid=,pgid= 2>/dev/null | awk -v g="$$" '$2 == g && $1 != g { print $1 }'
}

# Остановить потомков движка ДО размонтирования: иначе rsync/arch-chroot
# продолжат писать в $TARGET уже после umount — и записи уйдут в живую
# систему вместо целевого диска. Сначала SIGTERM, потом SIGKILL живым.
xros_kill_children() {
  local kids alive k g
  # Сначала — всей своей группе (если мы её лидер: так запускает GUI
  # через setsid): внуки, чей родитель уже умер, переродительствованны,
  # и обход по --ppid их не находит (проверено тестом E6: писатель
  # rsync пережил бы cleanup и продолжал писать в TARGET).
  # Себя не трогаем: SIGTERM себе во время cleanup убил бы нас
  # на середине размонтирования (в обработчике ловушки уже сняты).
  if [[ -n "${XROS_PGID:-}" && "$XROS_PGID" == "$$" ]]; then
    for g in $(xros_group_members); do kill -TERM "$g" 2>/dev/null || true; done
  fi
  kids=$(xros_descendants "$$")
  if [[ -n "${kids// }" ]]; then
    # shellcheck disable=SC2086
    kill -TERM $kids 2>/dev/null || true
    sleep 2
    alive=""
    for k in $kids; do
      kill -0 "$k" 2>/dev/null && alive="$alive $k"
    done
    if [[ -n "${alive// }" ]]; then
      # shellcheck disable=SC2086
      kill -KILL $alive 2>/dev/null || true
    fi
  else
    # Детей в дереве нет, но группе всё равно даём время на SIGTERM,
    # иначе umount ниже прошёл бы при ещё живом писателе.
    sleep 2
  fi
  # Добить группу: кто пережил SIGTERM (игнорирует его).
  if [[ -n "${XROS_PGID:-}" && "$XROS_PGID" == "$$" ]]; then
    for g in $(xros_group_members); do kill -KILL "$g" 2>/dev/null || true; done
  fi
}

# Идемпотентная очистка: флаг XROS_CLEANUP_DONE + снятие ловушек
# в обработчике (см. ниже) не дают вызвать её дважды — повторный вызов
# просто выходит, ничего не ломая и не завершая процесс второй раз.
# Успешный путь установки cleanup не вызывает: там размонтирование
# уже делается в конце run_install; флаг нужен только для сигналов.
xros_cleanup() {
  [[ "$XROS_CLEANUP_DONE" == "1" ]] && return 0
  XROS_CLEANUP_DONE=1
  say "Остановка установки (${XROS_STOP_REASON:-без указания причины}) — очистка..."
  xros_kill_children
  # Таймаут: занятая точка не должна вешать cleanup навсегда.
  timeout 15 umount -R "$TARGET" 2>/dev/null || true
  rm -f -- "$DE_RESULT_FILE" "$CONF"
  sync 2>/dev/null || true
  say "Очистка завершена: $TARGET размонтирован, временные файлы удалены"
}

xros_on_signal() {
  local sig="$1"
  # Первым делом ИГНОРИРОВАТЬ сигналы на время очистки. `trap -`
  # возвращал бы действия по умолчанию — и повторный SIGTERM
  # (двойная отмена из GUI: два cancel() подряд) убивал бы нас
  # на середине umount, до «Очистка завершена» (проверено тестом E7).
  # `trap ''` — именно игнор: повторный сигнал просто теряется,
  # а cleanup завершается и выходит с кодом сигнала как положено.
  trap '' HUP TERM INT
  case "$sig" in
    HUP)  XROS_STOP_REASON="SIGHUP (терминал/родитель закрыт)" ;;
    TERM) XROS_STOP_REASON="SIGTERM (родитель завершён или отмена из GUI)" ;;
    INT)  XROS_STOP_REASON="SIGINT (прерывание, Ctrl+C)" ;;
    *)    XROS_STOP_REASON="сигнал $sig" ;;
  esac
  xros_cleanup
  # В неинтерактивном режиме GUI ждёт маркер в stdout: без него
  # InstallEvent::Finished придёт только по закрытию pipe + wait(),
  # а явный маркер даёт GUI точный статус сразу. В интерактивном
  # режиме stdout — это dialog --gauge, маркер туда нельзя.
  if [[ -n "${NONINTERACTIVE:-}" ]]; then
    echo "INSTALL_FAILED"
  fi
  case "$sig" in
    HUP) exit 129 ;;
    INT) exit 130 ;;
    *) exit 143 ;;
  esac
}
trap 'xros_on_signal HUP' HUP
trap 'xros_on_signal TERM' TERM
trap 'xros_on_signal INT' INT

# Сторож родителя (фоновая проверка «родитель жив»).
# PDEATHSIG будит только сам движок, а ловушка bash НЕ выполняется,
# пока движок ждёт внешнюю команду на переднем плане (rsync, mkfs,
# pacman в chroot): сигнал повиснет до конца этой команды (минуты).
# Поэтому сторож раз в секунду смотрит, не сменился ли наш родитель
# (после смерти GUI нас переродительствовали, PPID стал другим),
# и шлёт SIGTERM всей группе: внешние команды умирают сразу,
# а ловушка движка выполняется, как только они завершились.
# Сторож запускается, только если движок — лидер своей группы
# (pgid == $$: так делает GUI через setsid; в интерактивном запуске
# из терминала — job control). Иначе SIGTERM группе мог бы задеть
# чужие процессы (например, оболочку, из которой запустили движок).
XROS_WATCHDOG_PID=""
xros_watchdog() {
  local parent="$1" pgid="$2" cur="" st=""
  while true; do
    sleep 1
    cur=$(ps -o ppid= -p $$ 2>/dev/null | tr -d ' ' || true)
    st=$(ps -o stat= -p $$ 2>/dev/null | tr -d ' ' || true)
    [[ -z "$cur" ]] && break
    # Зомби: движок уже мёртв, но родитель ещё не сделал wait() —
    # ppid зомби при этом НЕ меняется, и без проверки состояния
    # сторож крутился бы вечно, а GUI ждал бы EOF трубы, которую
    # держат живые внуки (взаимный deadlock, проверено тестом E5).
    [[ "$st" == Z* ]] && break
    [[ "$cur" == "$parent" ]] || break
  done
  kill -TERM -"$pgid" 2>/dev/null || true
}
XROS_PGID=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ' || true)
if [[ -n "$XROS_PGID" && "$XROS_PGID" == "$$" ]]; then
  xros_watchdog "$PPID" "$XROS_PGID" &
  XROS_WATCHDOG_PID=$!
  # При штатном выходе движка сторож больше не нужен: глушим его,
  # иначе он переживёт движок и при следующем... нет, после выхода
  # движка его PPID всё равно сменится, и он послал бы SIGTERM
  # группе, в которой уже никого нет. Всё равно глушим явно —
  # глушение сторожа входит в общую ловушку EXIT ниже.
fi

# Ловушка EXIT — страховка от обрыва НЕ сигналом: любой `exit 1`
# из run_install (явная проверка `|| { ...; exit 1; }`) раньше
# оставлял $TARGET смонтированным и временные файлы на месте —
# ловушки на сигналы такой выход не ловят. Теперь при ненулевом
# коде во время установки делаем тот же cleanup, что и по сигналу
# (идемпотентный: повторный вызов — no-op по XROS_CLEANUP_DONE;
# при выходе из xros_on_signal флаг уже стоит, двойной очистки нет).
# На успешном пути (rc=0 или установка ещё не начиналась) —
# только глушим сторожа.
xros_on_exit() {
  local rc=$?
  # kill с пустым PID не должен принимать текущую группу за цель:
  # side-effects от `&&`/`||` тут важнее читаемости.
  if [[ -n "${XROS_WATCHDOG_PID:-}" ]]; then
    kill "$XROS_WATCHDOG_PID" 2>/dev/null || true
  fi
  if [[ $rc -ne 0 && "${XROS_INSTALLING:-0}" == "1" && "$XROS_CLEANUP_DONE" != "1" ]]; then
    XROS_STOP_REASON="ошибка установки (код $rc)"
    xros_cleanup
    # Без маркера GUI узнал бы об ошибке только по закрытию pipe +
    # wait() — а явный INSTALL_FAILED даёт точный статус сразу.
    # Ветка `run_install || RC=$?` ниже до этого места не доходит:
    # `exit 1` из run_install убивает скрипт сразу, и только
    # ловушка EXIT ловит этот выход (проверено тестами E6/E8/E9).
    # В интерактивном режиме маркер в stdout нельзя (там dialog).
    if [[ -n "${NONINTERACTIVE:-}" ]]; then
      echo "INSTALL_FAILED"
    fi
  fi
}
trap xros_on_exit EXIT
# --- XROS: защита дочернего процесса (конец) ---

# --- XROS: защита диска (начало) ---
# Три проверки, которых не хватало первому аудиту:
#  1. Идентификатор устройства: между выбором диска и форматированием
#     проходят диалоги/шаги GUI — за это время диск могли переткнуть,
#     переименовать (/dev/sdX -> /dev/sdY) или переразметить. Одно имя
#     /dev-пути этому не препятствует, поэтому запоминаем стабильный
#     идентификатор (путь в sysfs + таблица разделов + PARTUUID)
#     и перепроверяем его непосредственно перед разрушительной
#     операцией (см. xros_verify_identity в run_install).
#  2. Смонтированные разделы: форматировать смонтированный раздел
#     нельзя — в первую очередь это сам ISO-носитель
#     (/run/archiso/bootmnt). Проверка не зависит от ISODISK, поэтому
#     закрывает и случай пустого ISODISK (нештатная загрузка).
#  3. Тип устройства: в ручном режиме корень и EFI обязаны быть
#     разделами (TYPE=part), а EFI — FAT; иначе mkfs отформатировал
#     бы целый диск, переданный как «раздел».

# Стабильный идентификатор устройства: путь в sysfs (не меняется при
# переименовании /dev-имени, меняется при перетыкании), плюс вывод
# lsblk (размер, тип, ФС, таблица разделов) и PARTUUID для разделов.
# Устройства нет — «MISSING:...»: такая строка никогда не совпадёт
# с сохранённой, и проверка ниже прервёт установку.
xros_dev_identity() {
  local dev="$1" base sysfs info puuid
  base=$(basename "$dev")
  if [[ ! -b "$dev" ]]; then
    printf 'MISSING:%s' "$dev"
    return 0
  fi
  sysfs=$(readlink -f "/sys/class/block/$base" 2>/dev/null || true)
  info=$(lsblk -n -o NAME,SIZE,TYPE,FSTYPE "$dev" 2>/dev/null | tr '\n' ';' || true)
  puuid=$(blkid -s PARTUUID -o value "$dev" 2>/dev/null || true)
  printf 'sysfs=%s|lsblk=%s|partuuid=%s' "${sysfs:-?}" "$info" "${puuid:-}"
}

# Перепроверить идентификатор непосредственно перед разрушительной
# операцией. Несовпадение — жёсткий стоп ДО wipefs/mkfs.
xros_verify_identity() {
  local what="$1" dev="$2" expected="$3" got
  got=$(xros_dev_identity "$dev")
  if [[ "$got" != "$expected" ]]; then
    say "ОШИБКА: $what изменился с момента выбора ($dev) — установка прервана, диск не тронут"
    say "  было:   $expected"
    say "  сейчас: $got"
    exit 1
  fi
}

# Есть ли смонтированные разделы у диска/раздела (кроме $TARGET,
# который мы сами размонтировали перед проверкой)? 0 — есть.
xros_has_mounts() {
  local dev="$1" mp
  while read -r mp; do
    [[ -n "${mp// }" ]] || continue
    case "$mp" in
      "$TARGET"|"$TARGET"/*) continue ;;
      *) return 0 ;;
    esac
  done < <(lsblk -n -o MOUNTPOINT "$dev" 2>/dev/null)
  return 1
}
# --- XROS: защита диска (конец) ---

# Зарезервированные системные имена (A-31): useradd их примет, но они
# конфликтуют с системными пользователями/сервисами (root, sddm, dbus
# и т.д.). Проверка — до разметки, в обоих режимах (неинтерактивном
# и диалоговом) и в GUI.
XROS_RESERVED_USERS="root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody systemd-network systemd-timesync systemd-resolve messagebus polkitd sddm dbus sshd avahi colord rtkit git http ftp"
xros_reserved_user() {
  local u="$1" r
  # shellcheck disable=SC2086
  for r in $XROS_RESERVED_USERS; do
    [[ "$u" == "$r" ]] && return 0
  done
  return 1
}

# A-24/A-38: диск/раздел заблокирован для установки, если на нём LVM/LUKS/RAID:
# wipefs/mkfs уничтожили бы чужие тома. Проверка — до любой разрушительной
# операции, в обеих ветках разметки.
# Возврат (R-04): 0 = заблокирован (и уже напечатана причина),
# 1 = свободен, 2 = ОШИБКА ПРОВЕРКИ (причина напечатана, продолжать
# нельзя). Прямой вызов в `if` НЕДОПУСТИМ: код 2 в `if` трактовался бы
# как «свободен» — вызывающие места обязаны использовать обёртку
# xros_require_disk_free().
#
# Две независимые ноги (обе должны сказать «свободен»):
#   1) lsblk FSTYPE/TYPE устройства и всех его потомков. Член MD RAID:
#      FSTYPE=linux_raid_member, TYPE=part/disk; сам массив:
#      TYPE=raid0/raid1/raid4/raid5/raid6/raid10. TYPE проверяется по
#      ПРЕФИКСУ raid* — точное == "raid" не ловит raid1/raid5.
#      R-02: FSTYPE-блоклист расширен всеми типами членов RAID/fakeraid,
#      которые распознаёт blkid (проверено strings libblkid):
#      linux_raid_member (MD), isw_raid_member (Intel RST),
#      ddf_raid_member (SNIA DDF), promise_fasttrack_raid_member,
#      adaptec_raid_member, hpt37x_raid_member, hpt45x_raid_member,
#      jmicron_raid_member, lsi_mega_raid_member (LSI MegaRAID),
#      nvidia_raid_member (nForce), silicon_medley_raid_member,
#      via_raid_member; плюс LVM1_member — тот же класс, что и
#      LVM2_member (физ. том LVM). zfs_member и VMFS_volume_member
#      сознательно не блокируются здесь: это файловые системы
#      пулов/хранилищ, а не члены RAID; решение по ним — отдельный этап.
#   2) blkid -p (прямое чтение сигнатуры с устройства, без кэша) для
#      устройства и всех его потомков: ловит НЕСОБРАННЫЙ массив, где
#      /proc/mdstat пуст и mdadm в живой системе нет. Семантика кодов
#      blkid -p (проверена на хосте: rc=0 — сигнатура найдена; файл
#      с magic ext4 даёт rc=0, пустой файл и случайные данные — rc=2):
#      R-18: rc=2 НЕОДНОЗНАЧЕН — это и «сигнатуры нет», и «устройство
#      не открывается» (несуществующий путь, каталог, /dev/null —
#      rc=2 при ПУСТОМ stderr; Permission denied — rc=2 при непустом
#      stderr). Поэтому rc=2 трактуется как «нет сигнатуры» ТОЛЬКО
#      после успешной пробы чтения устройства (xros_device_readable)
#      и при пустом stderr blkid; иначе — ошибка проверки (код 2).
#      Остальные коды blkid и ненулевой rc lsblk — ошибка проверки.
# Чистый диск без FSTYPE — норма: пустой вывод при rc=0 означает
# «сигнатур нет», а не ошибку (R-04).
xros_disk_blocked() {
  local dev="$1" reason=""
  local _blocked_fstypes='LVM1_member|LVM2_member|crypto_LUKS|linux_raid_member|isw_raid_member|ddf_raid_member|promise_fasttrack_raid_member|adaptec_raid_member|hpt37x_raid_member|hpt45x_raid_member|jmicron_raid_member|lsi_mega_raid_member|nvidia_raid_member|silicon_medley_raid_member|via_raid_member'
  # R-04: отсутствующая утилита — проверка невозможна, а не «свободно».
  command -v lsblk >/dev/null 2>&1 || { say "ОШИБКА: нет утилиты lsblk — невозможно проверить $dev, установка прервана для безопасности (R-04)"; return 2; }
  command -v blkid >/dev/null 2>&1 || { say "ОШИБКА: нет утилиты blkid — невозможно проверить $dev, установка прервана для безопасности (R-04)"; return 2; }
  # R-18: сначала — проба чтения. Без неё пустой вывод lsblk/blkid
  # (rc=0/2) неотличим от «устройство не читается», а значит,
  # ни одна нога не вправе вынести вердикт «свободен».
  xros_device_readable "$dev" || { say "ОШИБКА: устройство $dev не читается (нет узла, исчезло, нет прав или ошибка ввода-вывода) — невозможно проверить, установка прервана для безопасности (R-18)"; return 2; }
  local _out _rc
  _out="$(lsblk -n -o FSTYPE "$dev" 2>/dev/null)"; _rc=$?
  if [[ $_rc -ne 0 ]]; then say "ОШИБКА: lsblk не смог прочитать $dev (код $_rc) — проверка невозможна, установка прервана (R-04)"; return 2; fi
  if printf '%s\n' "$_out" | grep -qE "^(${_blocked_fstypes})$"; then
    reason="FSTYPE из блоклиста (LVM/LUKS/RAID)"
  else
    _out="$(lsblk -n -o TYPE "$dev" 2>/dev/null)"; _rc=$?
    if [[ $_rc -ne 0 ]]; then say "ОШИБКА: lsblk не смог прочитать $dev (код $_rc) — проверка невозможна, установка прервана (R-04)"; return 2; fi
    if printf '%s\n' "$_out" | grep -qE '^(lvm|crypt|raid)'; then
      reason="тома lvm/crypt/raid*"
    fi
  fi
  if [[ -z "$reason" ]]; then
    # Вторая нога: blkid -p по устройству и его потомкам (потомки —
    # из lsblk -o PATH; если lsblk не смог их перечислить — ошибка
    # проверки, а не молчаливое сужение до одного устройства).
    local _paths _prc d btype _brc _blkid_err _leg_rc
    _paths="$(lsblk -n -o PATH "$dev" 2>/dev/null)"; _prc=$?
    if [[ $_prc -ne 0 ]]; then say "ОШИБКА: lsblk не смог перечислить потомков $dev (код $_prc) — проверка невозможна, установка прервана (R-04)"; return 2; fi
    _blkid_err="$(mktemp)" || { say "ОШИБКА: не удалось создать временный файл для stderr blkid — проверка невозможна (R-18)"; return 2; }
    # Без trap RETURN: он протекает в вызывающую функцию и падает
    # под set -u на уже уничтоженной локальной переменной (поймано
    # тестом). Поэтому ранние выходы из цикла — через _leg_rc+break,
    # а удаление временного файла — в одном месте после цикла.
    _leg_rc=0
    for d in "$dev" $(printf '%s\n' "$_paths" | grep -vxF -- "$dev" || true); do
      # R-18: потомок тоже проверяется пробой чтения до blkid: rc=2
      # без неё неоднозначен (нет сигнатуры vs не открывается).
      if ! xros_device_readable "$d"; then
        say "ОШИБКА: устройство $d (потомок $dev) не читается — невозможно проверить, установка прервана для безопасности (R-18)"; _leg_rc=2; break
      fi
      # stderr blkid — второй различитель: Permission denied и другие
      # ошибки blkid сообщает в stderr (проверено), а «нет сигнатуры»
      # молчалива. Непустой stderr — ошибка проверки, даже при rc=2.
      btype="$(blkid -p -s TYPE -o value "$d" 2>"$_blkid_err")"; _brc=$?
      if [[ -s "$_blkid_err" ]]; then
        say "ОШИБКА: blkid сообщил об ошибке для $d: $(head -1 "$_blkid_err") — проверка невозможна, установка прервана (R-18)"; _leg_rc=2; break
      fi
      if [[ $_brc -eq 0 ]]; then
        if printf '%s\n' "$btype" | grep -qE "^(${_blocked_fstypes})$"; then
          reason="blkid TYPE=$btype ($d)"
          break
        fi
      elif [[ $_brc -eq 2 ]]; then
        : # сигнатуры нет: устройство доказано читаемым пробой выше,
        # а blkid молчалив — это норма для чистого устройства
      else
        say "ОШИБКА: blkid не смог прочитать $d (код $_brc) — проверка невозможна, установка прервана (R-04)"; _leg_rc=2; break
      fi
    done
    rm -f "$_blkid_err"
    if [[ $_leg_rc -ne 0 ]]; then return "$_leg_rc"; fi
  fi
  if [[ -n "$reason" ]]; then
    say "ОШИБКА: $dev заблокирован для установки ($reason): освободите диск вручную — установка на LVM/LUKS/RAID не поддерживается"
    return 0
  fi
  return 1
}

# R-18: устройство пригодно для проверки сигнатуры, только если
# его первый сектор читается. blkid -p с rc=2 НЕ различает
# «сигнатуры нет» и «устройство не открывается» (проверено на хосте:
# несуществующий путь, каталог, /dev/null — rc=2, stderr ПУСТ;
# Permission denied от имени nobody — rc=2, stderr непуст).
# Поэтому rc=2 трактуется как «нет сигнатуры» ТОЛЬКО после успешной
# пробы чтения; иначе — ошибка проверки (код 2), а не «свободен».
# Проба — чтение 512 байт (только чтение, разметка не меняется).
# [[ -b ]] отсекает не-блочные пути; head ловит исчезнувшее
# устройство (ENXIO), ошибку ввода-вывода и отсутствие носителя
# (ENOMEDIUM). Пустое устройство нулевого размера пробу проходит
# (EOF — не ошибка): сигнатуры на нём действительно нет, а размер
# проверяется отдельно при выборе цели установки.
xros_device_readable() {
  local d="$1"
  [[ -b "$d" ]] || return 1
  head -c 512 "$d" >/dev/null 2>&1
}
xros_require_disk_free() {
  local _rc
  xros_disk_blocked "$1"; _rc=$?
  [[ $_rc -eq 1 ]]
}

# P4-AUD-02: отключить конкурирующий менеджер входа в установленной
# системе. Различает «юнит отсутствует» (безопасно пропустить) и
# «реальная ошибка» (fail-closed). Юнит считается существующим, если
# его файл есть в одном из стандартных каталогов юнитов целевой
# системы. Уже отключённый юнит: systemctl disable завершается кодом 0
# (идемпотентен) — это не ошибка. Замаскированный юнит: его файл —
# симлинк на /dev/null, [ -e ] его видит, disable завершается кодом 0,
# маска при этом остаётся (снять её может только unmask — не делаем).
# P4-AUD-04 FIX-A: абсолютный симлинк на файл внутри цели тоже считается
# существующим (цель проверяется внутри $TARGET); висячий симлинк —
# по-прежнему пропуск (V-03, доказанно безвредно).
# R-22: разрешить путь внутри $TARGET (chroot-семантика).
# Алгоритм (покомпонентный, без обращения к хосту):
# - вход — абсолютный путь, как видит его установленная система
#   (напр. /usr/lib/systemd/system/gdm.service);
# - компоненты обрабатываются слева направо; уже разрешённый префикс
#   хранится как строка без ведущего / (resolved);
# - '.' и пустые компоненты пропускаются; '..' убирает последний
#   компонент, но не выходит выше корня цели (chroot-семантика);
# - каждый компонент проверяется на симлинк ([ -L ] под $TARGET);
#   цель читается readlink и подставляется в начало очереди:
#   абсолютная цель — относительно корня цели (resolved сбрасывается),
#   относительная — относительно каталога симлинка;
# - промежуточные симлинки разрешаются так же, как финальный;
# - лимит переходов 40 (как MAXSYMLINKS в ядре) — защита от циклов.
# - /dev/null считается существующим: arch-chroot bind-mountит /dev
#   в цель, поэтому маска (симлинк на /dev/null) — не висячая.
# $1 — путь внутри цели (абсолютный, с ведущим /).
# Печатает разрешённый абсолютный путь под $TARGET.
# Возврат: 0 — разрешён, конечный объект существует;
# 1 — висячий (цель не существует); 2 — цикл/слишком много переходов;
# 3 — ошибка (нечитаемый путь, readlink не удался).
xros_resolve_in_target() {
  local input="$1"
  local hops=0 max_hops=40
  local queue="$input" resolved="" comp rest full tgt
  while [[ -n "$queue" ]]; do
    case "$queue" in
      */*) comp="${queue%%/*}"; rest="${queue#*/}" ;;
      *)   comp="$queue"; rest="" ;;
    esac
    queue="$rest"
    case "$comp" in
      ''|'.') continue ;;
      '..')
        case "$resolved" in
          */*) resolved="${resolved%/*}" ;;
          *)   resolved="" ;;
        esac
        ;;
      *)
        if [[ -n "$resolved" ]]; then
          resolved="$resolved/$comp"
        else
          resolved="$comp"
        fi
        full="$TARGET/$resolved"
        if [[ -L "$full" ]]; then
          tgt="$(readlink "$full")" || return 3
          hops=$((hops+1))
          (( hops > max_hops )) && return 2
          case "$resolved" in
            */*) resolved="${resolved%/*}" ;;
            *)   resolved="" ;;
          esac
          if [[ "$tgt" == /* ]]; then
            # Абсолютная цель — относительно корня цели.
            if [[ -n "$queue" ]]; then
              queue="${tgt#/}/$queue"
            else
              queue="${tgt#/}"
            fi
            resolved=""
          else
            # Относительная цель — относительно каталога симлинка.
            if [[ -n "$queue" ]]; then
              queue="$tgt/$queue"
            else
              queue="$tgt"
            fi
          fi
        fi
        ;;
    esac
  done
  local final="$TARGET/$resolved"
  # R-22: /dev/null — особый случай. arch-chroot bind-mountит /dev в цель,
  # поэтому /dev/null существует внутри chroot, даже если на диске
  # $TARGET/dev/null нет. Маска (симлинк на /dev/null) — не висячая:
  # disable на замаскированном юните возвращает rc=0 (R8), а
  # xros_verify_default_target отклоняет её отдельной проверкой.
  if [[ "$final" == "$TARGET/dev/null" ]] || [[ -e "$final" ]]; then
    printf '%s\n' "$final"
    return 0
  fi
  return 1
}

xros_disable_dm() {
  local unit="$1"
  local f resolved rc
  for f in "$TARGET/usr/lib/systemd/system/$unit" \
           "$TARGET/usr/local/lib/systemd/system/$unit" \
           "$TARGET/etc/systemd/system/$unit"; do
    # R-22 (R21-A-LOW-1, R21-A-LOW-2): разрешить путь внутри $TARGET
    # (chroot-семантика). Прямые [ -e ] и readlink разрешают абсолютные
    # симлинки относительно хоста, а не $TARGET; цепочки — только один
    # уровень. Resolver следует по цепочкам внутри $TARGET.
    resolved="$(xros_resolve_in_target "${f#$TARGET}")"
    rc=$?
    case "$rc" in
      0)
        # существует внутри цели — отключаем
        ;;
      1)
        # висячий симлинк (V-03, доказанно безвредно: systemctl disable
        # на висячем юните возвращает rc=1, вызывать его нельзя) — пропуск
        continue
        ;;
      2)
        say "ОШИБКА: не удалось определить состояние $unit: циклическая ссылка в установленной системе (см. $LOG)"; exit 1
        ;;
      *)
        say "ОШИБКА: не удалось определить состояние $unit: ошибка разрешения пути в установленной системе (см. $LOG)"; exit 1
        ;;
    esac
    arch-chroot "$TARGET" systemctl disable "$unit" >>"$LOG" 2>&1 \
      || { say "ОШИБКА: не удалось отключить $unit в установленной системе — конкурирующий менеджер входа останется включённым (см. $LOG)"; exit 1; }
    return 0
  done
  say "Пропуск: $unit отсутствует в установленной системе"
  return 0
}

# P4-AUD-02 V-01: проверить владельца display-manager.service ДО
# настройки менеджера входа. Если alias уже принадлежит неизвестному
# менеджеру входа (не sddm/lightdm/gdm и не выбранный DM), установка
# прерывается fail-closed: установщик НЕ перезаписывает чужой alias
# и НЕ удаляет неизвестный DM — его владелец и состояние неизвестны,
# а принудительная перезапись могла бы сломать чужую систему.
# Висячий alias — не отказ: реальный systemctl удаляет его и создаёт
# заново (проверено A1). Alias как обычный файл/каталог — отказ:
# enable всё равно упал бы (E14/B1/B2), но здесь ошибка понятнее и
# частичное состояние (wants-симлинк) не создаётся.
# Вызывается в графических ветках ДО цикла отключения конкурентов.
# В ветке DE=none не вызывается: DM не включается, alias не важен
# (цель по умолчанию — multi-user.target).
xros_check_dm_alias() {
  local link="$TARGET/etc/systemd/system/display-manager.service"
  local target name upath
  # DM не выбран — проверять нечего.
  [[ -n "$DE_DM" ]] || return 0
  # Alias отсутствует — нечего проверять.
  [[ -e "$link" || -L "$link" ]] || return 0
  # Alias существует, но не симлинк — enable упадёт; даём понятную
  # ошибку раньше, чем создавать частичное состояние.
  if [[ ! -L "$link" ]]; then
    if [[ -d "$link" ]]; then
      say "ОШИБКА: display-manager.service в установленной системе — каталог, а не симлинк; установщик не может безопасно включить $DE_DM. Удалите этот каталог вручную и повторите установку (см. $LOG)"
    else
      say "ОШИБКА: display-manager.service в установленной системе — обычный файл, а не симлинк; установщик не может безопасно включить $DE_DM. Удалите этот файл вручную и повторите установку (см. $LOG)"
    fi
    exit 1
  fi
  target="$(readlink "$link")" || { say "ОШИБКА: не удалось прочитать display-manager.service в установленной системе (см. $LOG)"; exit 1; }
  # Имя владельца alias (basename цели без .service).
  name="${target##*/}"
  name="${name%.service}"
  # Выбранный DM или известный конкурент — порядок: цикл отключения
  # снимет alias конкурента, enable выбранного идемпотентен.
  case "$name" in
    "$DE_DM"|sddm|lightdm|gdm) return 0 ;;
  esac
  # Висячий alias (цель не существует внутри цели) — systemctl
  # удаляет его и создаёт заново, это не конфликт.
  case "$target" in
    /*) upath="$TARGET$target" ;;
    *)  upath="$TARGET/etc/systemd/system/$target" ;;
  esac
  [[ -e "$upath" || -L "$upath" ]] || return 0
  # Неизвестный владелец с существующей целью — fail-closed.
  say "ОШИБКА: display-manager.service в установленной системе уже принадлежит неизвестному менеджеру входа «$name» ($target). Установщик не перезаписывает чужой alias и не удаляет неизвестный менеджер входа. Безопасное устранение: отключите $name в установленной системе (arch-chroot $TARGET systemctl disable $name.service) и повторите установку (см. $LOG)"
  exit 1
}

# P4-AUD-02 V-07: финальная проверка менеджера входа по РЕАЛЬНОМУ
# состоянию установленной системы, а не по подстроке имени. Проверяет:
# alias — симлинк; цель — ровно $DE_DM.service (точное имя, не
# подстрока: sddm-foo.service не проходит); файл цели существует
# (не висячий alias); это обычный файл (не каталог); юнит не
# замаскирован (не симлинк на /dev/null); в файле есть секция [Unit].
# Любое несоответствие — fail-closed. Гонка TOCTOU между enable и
# проверкой (класс R-05) остаётся, но окно сужено: проверяется
# реальное состояние, а не строка.
xros_verify_dm() {
  local link="$TARGET/etc/systemd/system/display-manager.service"
  local target name upath
  [[ -L "$link" ]] || { say "ОШИБКА: менеджер входа $DE_DM не включён: display-manager.service в установленной системе отсутствует или не является симлинком"; exit 1; }
  target="$(readlink "$link")" || { say "ОШИБКА: не удалось прочитать display-manager.service в установленной системе (см. $LOG)"; exit 1; }
  name="${target##*/}"
  [[ "$name" == "$DE_DM.service" ]] || { say "ОШИБКА: менеджер входа $DE_DM не включён: display-manager.service указывает на $target, а не на $DE_DM.service"; exit 1; }
  case "$target" in
    /*) upath="$TARGET$target" ;;
    *)  upath="$TARGET/etc/systemd/system/$target" ;;
  esac
  [[ -e "$upath" || -L "$upath" ]] || { say "ОШИБКА: менеджер входа $DE_DM не включён: display-manager.service указывает на несуществующий юнит $target (висячий alias)"; exit 1; }
  if [[ -L "$upath" && ! -e "$upath" ]]; then
    say "ОШИБКА: менеджер входа $DE_DM не включён: юнит $target — висячий симлинк"; exit 1
  fi
  if [[ -L "$upath" ]] && [[ "$(readlink "$upath")" == "/dev/null" ]]; then
    say "ОШИБКА: менеджер входа $DE_DM не включён: юнит $target замаскирован (симлинк на /dev/null)"; exit 1
  fi
  [[ -f "$upath" ]] || { say "ОШИБКА: менеджер входа $DE_DM не включён: юнит $target — не обычный файл"; exit 1; }
  grep -q '^\[Unit\]' "$upath" || { say "ОШИБКА: менеджер входа $DE_DM не включён: юнит $target повреждён (нет секции [Unit])"; exit 1; }
}

# P4-AUD-04 FIX-B (V-09): проверка default target для ветки DE=none.
# Подтверждает по реальному состоянию цели, что default.target —
# симлинк на ожидаемый юнит (multi-user.target), цель существует
# внутри цели, является обычным файлом с секцией [Unit] и не замаскирована.
# Абсолютные пути разрешаются внутри $TARGET, а не по хосту.
xros_verify_default_target() {
  local expected="$1"
  local link="$TARGET/etc/systemd/system/default.target"
  local target name resolved rc upath
  [[ -L "$link" ]] || { say "ОШИБКА: default target не задан: $link отсутствует или не является симлинком в установленной системе (см. $LOG)"; exit 1; }
  target="$(readlink "$link")" || { say "ОШИБКА: не удалось прочитать default.target в установленной системе (см. $LOG)"; exit 1; }
  name="${target##*/}"
  [[ "$name" == "$expected" ]] || { say "ОШИБКА: default target указывает на $target, а не на $expected (см. $LOG)"; exit 1; }
  # R-22 (R21-B-LOW-1): разрешить цель внутри $TARGET (chroot-семантика).
  # Прямая проверка [ -e "$TARGET$target" ] следует по симлинкам
  # относительно хоста: юнит-симлинк на хостовый файл с [Unit]
  # принимался. Resolver гарантирует, что конечный файл — внутри $TARGET.
  case "$target" in
    /*) resolved="$(xros_resolve_in_target "$target")" ;;
    *)  resolved="$(xros_resolve_in_target "/etc/systemd/system/$target")" ;;
  esac
  rc=$?
  case "$rc" in
    0) upath="$resolved" ;;
    1) say "ОШИБКА: default target висячий: цель $target отсутствует в установленной системе (см. $LOG)"; exit 1 ;;
    2) say "ОШИБКА: default target висячий: цель $target — циклическая ссылка в установленной системе (см. $LOG)"; exit 1 ;;
    *) say "ОШИБКА: default target висячий: не удалось разрешить цель $target в установленной системе (см. $LOG)"; exit 1 ;;
  esac
  # upath — реальный файл внутри $TARGET (resolver уже следовал по
  # симлинкам; маска на /dev/null даёт либо висячий, либо не-файл).
  if [[ "$upath" == "$TARGET/dev/null" ]]; then
    say "ОШИБКА: default target $expected замаскирован (симлинк на /dev/null) (см. $LOG)"; exit 1
  fi
  [[ -f "$upath" ]] || { say "ОШИБКА: default target $expected — не обычный файл (см. $LOG)"; exit 1; }
  grep -q '^\[Unit\]' "$upath" || { say "ОШИБКА: default target $expected повреждён: нет секции [Unit] (см. $LOG)"; exit 1; }
}

# --- XROS: импорт ключа XrOS (начало) ---
# A-40: production-ключ XrOS в keyring установленной системы.
# Источник истины — /usr/share/xros/xros-gpg.conf в живой системе
# (тот же файл, что в customize и build.sh) и публичный ключ
# /usr/share/xros/xros-public.key (копируется rsync'ом в цель).
# Пока FPR пуст — production GPG не настроен: явное предупреждение,
# установка продолжается (пакеты уже на месте), но [xros] не
# объявляется рабочим. Когда FPR задан — строгий путь: проверка
# ключа, --add, проверка отпечатка, --lsign-key, проверка наличия
# в keyring цели. Любая ошибка — возврат 1, вызов останавливает
# установку ДО операций, зависящих от [xros] (pacman -S ниже).
xros_import_xros_key() {
  local fpr="" key_src="/usr/share/xros/xros-public.key"
  if [[ -f /usr/share/xros/xros-gpg.conf ]]; then
    # shellcheck disable=SC1091
    . /usr/share/xros/xros-gpg.conf
    fpr="${XROS_GPG_PROD_FPR:-}"
  fi
  if [[ -z "$fpr" ]]; then
    say "ВНИМАНИЕ: production GPG не настроен (XROS_GPG_PROD_FPR пуст) — ключ XrOS не импортирован в установленную систему, репозиторий [xros] не будет проверяться подписью (A-40)"
    return 0
  fi
  [[ -f "$key_src" ]] || { say "ОШИБКА: production GPG: нет $key_src при заданном XROS_GPG_PROD_FPR=$fpr (A-40)"; return 1; }
  /usr/local/bin/xros-gpg-check "$key_src" "$fpr" >>"$LOG" 2>&1 \
    || { say "ОШИБКА: production GPG: публичный ключ не прошёл проверку отпечатка (A-40) — см. $LOG"; return 1; }
  arch-chroot "$TARGET" pacman-key --add /usr/share/xros/xros-public.key >>"$LOG" 2>&1 \
    || { say "ОШИБКА: pacman-key --add не удался в установленной системе (A-40) — см. $LOG"; return 1; }
  local finger_out
  finger_out="$(arch-chroot "$TARGET" pacman-key --finger "$fpr" 2>&1)" \
    || { say "ОШИБКА: pacman-key --finger не удался в установленной системе (A-40) — см. $LOG"; return 1; }
  printf '%s\n' "$finger_out" >>"$LOG"
  printf '%s' "$finger_out" | tr -d '[:space:]' | grep -qi "${fpr// /}" \
    || { say "ОШИБКА: отпечаток $fpr не найден в keyring установленной системы после --add (A-40)"; return 1; }
  arch-chroot "$TARGET" pacman-key --lsign-key "$fpr" >>"$LOG" 2>&1 \
    || { say "ОШИБКА: pacman-key --lsign-key не удался в установленной системе (A-40) — см. $LOG"; return 1; }
  arch-chroot "$TARGET" pacman-key --list-keys "$fpr" >>"$LOG" 2>&1 \
    || { say "ОШИБКА: ключ $fpr не найден в keyring установленной системы после --lsign-key (A-40) — см. $LOG"; return 1; }
  say "GPG: production-ключ $fpr импортирован в установленную систему (A-40)"
  return 0
}
# --- XROS: импорт ключа XrOS (конец) ---

# --- Пункт 7 (1.1): подписан ли репозиторий [xros] ---
# Ворота для автообновления (xros-auto-update.timer): таймер можно
# включать ТОЛЬКО если репозиторий [xros] подписан — нужны ОБА условия:
#   1) production-ключ настроен (XROS_GPG_PROD_FPR задан в
#      /usr/share/xros/xros-gpg.conf; сам ключ уже импортирован выше
#      функцией xros_import_xros_key — при её ошибке установка
#      прервалась бы раньше, до этого места);
#   2) SigLevel для [xros] в pacman.conf цели равен Required — явная
#      строка в секции [xros], глобальный SigLevel не считается
#      (fail-closed: если секция молчит, считаем неподписанным).
# Одного ключа без Required мало: при SigLevel Optional pacman принял
# бы и неподписанные пакеты. Возврат: 0 — подписан, 1 — нет.
xros_xros_repo_signed() {
  local fpr="" conf="$TARGET/etc/pacman.conf" sig=""
  if [[ -f /usr/share/xros/xros-gpg.conf ]]; then
    # shellcheck disable=SC1091
    . /usr/share/xros/xros-gpg.conf
    fpr="${XROS_GPG_PROD_FPR:-}"
  fi
  [[ -n "$fpr" ]] || return 1
  [[ -f "$conf" ]] || return 1
  sig=$(awk '/^\[xros\]/{in_xros=1; next} /^\[/{in_xros=0} in_xros && /^[[:space:]]*SigLevel[[:space:]]*=/ {print; exit}' "$conf" 2>/dev/null || true)
  [[ "$sig" == *"Required"* ]] || return 1
  return 0
}

# A-25: после пересоздания таблицы разделов ядро/udev должны увидеть
# новые узлы ДО mkfs: голый `sleep 1` — гонка (на медленном железе
# узла ещё нет, mkfs падает). partprobe + udevadm settle + цикл
# ожидания: хотя бы один из узлов-кандидатов должен появиться.
# $1 — диск, остальные — узлы-кандидаты (${DISK}p1/${DISK}1 и т.п.).
xros_wait_part() {
  local disk="$1"; shift
  local part i=0
  partprobe "$disk" 2>/dev/null || true
  udevadm settle --timeout=10 2>/dev/null || true
  while [[ $i -lt 20 ]]; do
    for part in "$@"; do
      [[ -b "$part" ]] && return 0
    done
    sleep 0.5
    i=$((i+1))
  done
  # A-25 (испр.): таймаут ожидания — НЕ жёсткая ошибка. Ниже есть
  # fallback по суффиксу ([[ -b "${DISK}p1" ]] → p-суффикс, иначе
  # обычный), а mkfs сообщит об ошибке, если узла реально нет.
  # Жёсткий exit 1 здесь ломал и тестовый стенд (фиктивный диск без
  # настоящих узлов разделов), и диски, где udev медленный.
  say "ВНИМАНИЕ: разделы не появились после разметки $disk за 10 с (udev): $* — продолжаю с проверкой суффикса; mkfs сообщит об ошибке, если узла нет"
  return 0
}

# Форматирование корневого раздела под выбранную ФС.
mkfs_root() {
  local part="$1" fs="$2"
  # A-38: последняя проверка непосредственно перед mkfs: раздел мог
  # стать членом RAID между выбором и форматированием, а GUI мог
  # пропустить его другим путём — движок не форматирует заблокированное.
  if ! xros_require_disk_free "$part"; then return 1; fi
  case "$fs" in
    btrfs)
      mkfs.btrfs -f -L XROS-OS "$part" >>"$LOG" 2>&1
      ;;
    xfs)
      mkfs.xfs -f -L XROS-OS "$part" >>"$LOG" 2>&1
      ;;
    *) # ext4 — по умолчанию
      mkfs.ext4 -F -L XROS-OS "$part" >>"$LOG" 2>&1
      ;;
  esac
}

# --- Пункт 4 (1.1): живой прогресс копирования (progress2, человеческие единицы) ---
# Проблема: rsync --info=progress2 пишет прогресс только в $LOG, а gauge
# во время копирования стоит на 30% и прыгает сразу на 70% — отсюда
# «скачущие проценты»; без --human-readable размеры в журнале — в байтах.
# GUI (src/xros-install-gui-rs/src/install.rs) и dialog --gauge понимают
# ТОЛЬКО протокол gauge: число = процент, XXX/сообщение/XXX, маркеры
# INSTALL_DONE/INSTALL_FAILED. Сырой вывод rsync им не нужен и туда
# не идёт — поэтому rsync остаётся на переднем плане с тем же вызовом
# (та же строка, та же проверка ошибки — см. T0a7 в test-installer-security.sh),
# а рядом, в фоне, работает этот опросчик: он читает из $LOG свежие строки
# progress2 (формат с --human-readable: `  41.94M  57%  689.12MB/s  0:00:00 ...`)
# и печатает в stdout gauge-числа 30..60 и XXX-статус с размером
# и скоростью в МБ/ГБ. Процент rsync — кумулятивный (байты уже
# скопированные / всего), поэтому он монотонно растёт сам по себе:
# сглаживание — это запрет на повтор/откат (печатаем только строго
# большее значение), усреднять нечего. Опросчик глушится сразу после
# rsync (kill+wait), а при обрыве — ловушкой EXIT/cleanup, как все
# потомки движка. Если progress-строк нет (короткое копирование,
# заглушка rsync в тестах) — опросчик молчит, gauge идёт 30 -> 70,
# как раньше.
# $1 — байтовое смещение в $LOG, с которого начался rsync.
xros_rsync_gauge() {
  local off="${1:-0}" last=30 pct=0 gauge=0 line="" size="" speed=""
  while kill -0 "$PPID" 2>/dev/null; do
    sleep 0.5
    line=$(tail -c +"$((off + 1))" "$LOG" 2>/dev/null | tr '\r' '\n' \
      | grep -E '^[[:space:]]*[0-9.]+[KMGT]?[[:space:]]+[0-9]+%[[:space:]]+[0-9.]+[kKMGT]?B/s' \
      | tail -n 1 || true)
    [[ -z "$line" ]] && continue
    pct=$(printf '%s' "$line" | grep -oE '[0-9]+%' | head -n 1 | tr -d '%' || true)
    [[ "$pct" =~ ^[0-9]+$ ]] || continue
    (( pct > 100 )) && pct=100
    gauge=$((30 + pct * 30 / 100))
    (( gauge <= last )) && continue
    last=$gauge
    size=$(printf '%s' "$line" | awk '{print $1}')
    speed=$(printf '%s' "$line" | awk '{print $3}')
    echo "$gauge"
    echo "XXX"
    echo "Копирование системы: $pct% (скопировано $size, скорость $speed)"
    echo "XXX"
  done
  return 0
}

# --- Пункт 10 (1.1): автоопределение железа и драйверы ---
# Установщик определяет ЦП и видеокарту живой системы (то же железо,
# что у цели: установка копирует систему на этот же компьютер) и
# ставит подходящие пакеты в установленную систему через
# arch-chroot pacman -S. Вызывается из run_install СРАЗУ после
# копирования ядра и ДО grub-mkconfig: grub-mkconfig сам включает
# /boot/intel-ucode.img и /boot/amd-ucode.img в grub.cfg, поэтому
# микрокод должен лежать в /boot уже к моменту его запуска.
#   ЦП: vendor_id из /proc/cpuinfo — GenuineIntel -> intel-ucode,
#     AuthenticAMD -> amd-ucode; не распознан — ничего не ставится.
#   GPU: lspci (VGA/3D controller) — NVIDIA -> nvidia-open +
#     nvidia-utils, AMD -> mesa + vulkan-radeon (amdgpu в ядре),
#     Intel -> mesa + vulkan-intel. Гибридная графика (Intel+NVIDIA)
#     ставит оба стека. lspci нет — GPU пропускается; GPU не
#     распознан (например, VMware/VirtualBox SVGA) — ничего не ставится.
#   DE=none: консольная система — стек GPU не ставится, только микрокод
#     (ветка none позже всё равно чистит графику).
# NVIDIA: ставится nvidia-open, а не проприетарный nvidia. nvidia-open —
# открытый kernel-модуль, рекомендованный Arch Wiki драйвером по
# умолчанию для Turing (GTX 16xx, RTX 20xx) и новее, то есть для всех
# карт, которые сейчас продаются и поддерживаются; проприетарный nvidia
# нужен только для pre-Turing (GTX 10xx и старше). PCI ID в поколения
# карт движок не отображает (таблица на сотни ID), поэтому ставится
# nvidia-open, а владельцам старых карт журнал честно говорит заменить
# его на nvidia.
# Без сети установка пакетов невозможна — шаг тихо пропускается
# с предупреждением, установка НЕ падает. Ошибка pacman -S тоже
# не роняет установку: драйверы можно доустановить позже.
xros_install_hw_drivers() {
  local cpu_vendor="" ucode_pkg="" hw_pkgs="" gpu_info=""
  local has_nvidia=0 has_amd=0 has_intel=0
  cpu_vendor=$(grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}' || true)
  case "$cpu_vendor" in
    GenuineIntel) ucode_pkg="intel-ucode" ;;
    AuthenticAMD) ucode_pkg="amd-ucode" ;;
    *) say "ЦП не распознан (vendor_id=${cpu_vendor:-неизвестен}) — микрокод не ставится" ;;
  esac
  if command -v lspci >/dev/null 2>&1; then
    gpu_info=$(lspci -nn 2>/dev/null | grep -iE 'VGA compatible controller|3D controller' || true)
    case "$gpu_info" in *NVIDIA*) has_nvidia=1 ;; esac
    case "$gpu_info" in *Advanced\ Micro\ Devices*|*AMD*) has_amd=1 ;; esac
    case "$gpu_info" in *Intel*) has_intel=1 ;; esac
  else
    say "ВНИМАНИЕ: нет утилиты lspci — видеокарта не определена, драйверы GPU не ставятся"
  fi
  # DE=none: консольная система — графический стек не ставится, только
  # микрокод (ветка none позже всё равно чистит графику). Проверка —
  # через одиночное `=`: строка проверки none — маркер, по которому
  # test-de-none.sh извлекает ветку none, а метка none) — маркер
  # case_line; дублировать их вне ветки нельзя (иначе извлечение
  # начнётся с этой функции).
  if [[ "$DE" = "none" ]]; then
    say "Без графики (DE=none): драйверы GPU не ставятся, только микрокод ЦП"
    has_nvidia=0; has_amd=0; has_intel=0
  fi
  hw_pkgs="$ucode_pkg"
  if (( has_nvidia == 1 )); then
    hw_pkgs="$hw_pkgs nvidia-open nvidia-utils"
    say "NVIDIA: ставится nvidia-open (Turing и новее); для карт GTX 10xx и старше замените на проприетарный nvidia: pacman -S nvidia nvidia-utils"
  fi
  if (( has_amd == 1 )); then hw_pkgs="$hw_pkgs mesa vulkan-radeon"; fi
  if (( has_intel == 1 )); then hw_pkgs="$hw_pkgs mesa vulkan-intel"; fi
  hw_pkgs="${hw_pkgs# }"
  if [[ -z "$hw_pkgs" ]]; then
    say "Драйверы железа не требуются (ЦП и GPU не опознаны) — ничего не ставится"
    return 0
  fi
  say "Железо: ЦП ${cpu_vendor:-неизвестен}, GPU nvidia=$has_nvidia amd=$has_amd intel=$has_intel — ставлю в установленную систему: $hw_pkgs"
  if ! arch-chroot "$TARGET" pacman -Sy --noconfirm >>"$LOG" 2>&1; then
    say "ВНИМАНИЕ: драйверы железа ($hw_pkgs) не установлены — нет сети или недоступны зеркала (pacman -Sy не удался); доустановить позже: pacman -S $hw_pkgs"
    return 0
  fi
  # shellcheck disable=SC2086
  if arch-chroot "$TARGET" pacman -S --noconfirm --needed $hw_pkgs >>"$LOG" 2>&1; then
    say "Драйверы железа установлены: $hw_pkgs"
  else
    say "ВНИМАНИЕ: драйверы железа ($hw_pkgs) установлены не полностью (см. $LOG); доустановить позже: pacman -S $hw_pkgs"
  fi
  return 0
}

# --- XROS: безопасный парсер конфигурации (начало) ---
xros_decode_config_value() {
  local raw="$1" body out="" prefix rest
  [[ "${raw:0:1}" == "'" && "${raw: -1}" == "'" ]] || return 1
  body="${raw:1:${#raw}-2}"
  while [[ -n "$body" ]]; do
    if [[ "$body" != *"'"* ]]; then
      out+="$body"
      body=""
    else
      prefix="${body%%\'*}"
      out+="$prefix"
      rest="${body:${#prefix}}"
      [[ "${rest:0:4}" == "'\\''" ]] || return 1
      out+="'"
      body="${rest:4}"
    fi
  done
  printf '%s' "$out"
}

xros_load_config() {
  local line key raw value
  declare -A seen=()
  [[ "$CONF" == "$RUNTIME_DIR/xros-install.conf" ]] || { say "ОШИБКА: недопустимый путь конфигурации"; return 1; }
  [[ -f "$CONF" && ! -L "$CONF" && -O "$CONF" ]] || { say "ОШИБКА: небезопасный файл настроек"; return 1; }
  [[ "$(stat -c '%a' "$CONF" 2>/dev/null || true)" == "600" ]] || { say "ОШИБКА: небезопасные права файла настроек"; return 1; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || { say "ОШИБКА: недопустимая строка конфигурации"; return 1; }
    key="${BASH_REMATCH[1]}"; raw="${BASH_REMATCH[2]}"
    case "$key" in
      DISK|PARTMODE|ROOT_PART|EFI_PART|FS|HOSTNAME|FULLNAME|USERNAME|USERPASS|ROOTPASS|AUTOLOGIN|TIMEZONE|KEYMAP|DE|OFFICE) ;;
      *) say "ОШИБКА: неизвестный параметр конфигурации $key"; return 1 ;;
    esac
    [[ -z "${seen[$key]+x}" ]] || { say "ОШИБКА: дублированный параметр конфигурации $key"; return 1; }
    value=$(xros_decode_config_value "$raw") || { say "ОШИБКА: недопустимое значение конфигурации $key"; return 1; }
    seen[$key]=1
    printf -v "$key" '%s' "$value"
  done < "$CONF"
  rm -f -- "$CONF"
}
# --- XROS: безопасный парсер конфигурации (конец) ---

if [[ -n "$NONINTERACTIVE" ]]; then
  [[ -n "${XROS_INSTALL_CONF:-}" ]] || { say "ОШИБКА: не задан путь конфигурации"; exit 1; }
  CONF="$XROS_INSTALL_CONF"
  xros_load_config || { rm -f -- "$CONF"; exit 1; }
  : "${PARTMODE:=erase}"
  : "${FS:=ext4}"
  : "${TIMEZONE:=Europe/Astrakhan}"
  : "${KEYMAP:=ru}"
  : "${AUTOLOGIN:=0}"
  : "${OFFICE:=none}"
  : "${DE:=kde}"
  : "${FULLNAME:=${USERNAME:-xros}}"
  [[ -n "${DISK:-}" || -n "${ROOT_PART:-}" ]] || { say "ОШИБКА: не задан диск/раздел"; exit 1; }
  [[ -n "${USERNAME:-}" && -n "${USERPASS:-}" ]] || { say "ОШИБКА: не заданы пользователь/пароль"; exit 1; }
  [[ -n "${ROOTPASS:-}" ]] || ROOTPASS="$USERPASS"
  USERNAME=$(echo "$USERNAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_')
