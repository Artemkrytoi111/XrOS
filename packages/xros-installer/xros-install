  # RFC 1123: без точек/дефисов по краям и без двойных точек.
  # Не прошло — заменяем на безопасное значение.
  if ! [[ "$HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$ ]] \
