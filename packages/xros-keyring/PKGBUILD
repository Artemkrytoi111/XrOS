# XrOS — переходный пакет xros-keyring: новый production GPG-ключ.
# Доставляет проверенный публичный ключ нового production-ключа
# (отпечаток 9E71EDB1A341779B7F0B99EAD1A3963AA4E45CEB) в установленные
# системы, которые сейчас доверяют только старому ключу.
# post_install импортирует ключ и локально подписывает его (pacman-key),
# после чего система доверяет обоим ключам. Старый ключ НЕ удаляется.
# Пакет идемпотентен: повторная установка/обновление безопасны.
# Кандидат Фазы 5 (ротация production-ключа): подписывается старым
# production-ключом на переходный период. В пакете — ТОЛЬКО публичный
# ключ; приватных ключей, паролей и сертификатов отзыва нет.
# PLACEHOLDER: https://xros.example — домена не существует,
# настоящий домен/сайт XrOS ещё не выбран (см. ARCHITECTURE.md).

pkgname=xros-keyring
pkgver=1.0
pkgrel=1
pkgdesc="Переходный пакет ключей XrOS: новый production GPG-ключ"
arch=('any')
url="https://xros.example"
license=('custom:XrOS')
# Зависимость от pacman намеренно НЕ указана: pacman-key и gpg, используемые
# в post_install, входят в пакет pacman, а сам pacman — это пакетный
# менеджер, без которого установка любого пакета невозможна. Зависимость
# была бы тавтологией и ломала бы установку в минимальных корнях.
options=('!debug')
install=xros-keyring.install
source=('xros-public-new.key')
sha256sums=('3ffb45e5bf500c51590088621632a48b0c7ab0ba84eb846f295b624f128e5d5e')

prepare() {
  # Защита на этапе сборки: в пакете должен быть ровно проверенный ключ.
  local fpr
  fpr="$(gpg --batch --show-keys --with-colons "$srcdir/xros-public-new.key" 2>/dev/null | awk -F: '$1 == "fpr" {print $10}')"
  [[ "$fpr" == "9E71EDB1A341779B7F0B99EAD1A3963AA4E45CEB" ]] \
    || { error "xros-public-new.key: отпечаток $fpr не совпадает с ожидаемым 9E71EDB1A341779B7F0B99EAD1A3963AA4E45CEB"; exit 1; }
}

package() {
  install -Dm644 xros-public-new.key "$pkgdir/usr/share/xros/xros-public-new.key"
}
