#!/usr/bin/env bash
# XrOS — установщик (консольный, bash+dialog).
# Работает из живой системы XrOS: размечает диск, копирует систему,
# ставит GRUB, создаёт пользователя.
#
# Два режима:
#  * интерактивный (по умолчанию) — диалоги dialog;
#  * неинтерактивный — для графического установщика (xros-install-gui):
#    XROS_NONINTERACTIVE=1 XROS_INSTALL_CONF=/tmp/xros-install.conf xros-install
#    Конфиг — файл KEY='value' (права 600, создаёт GUI, установщик удаляет
#    его после чтения). Значения: DISK, PARTMODE (erase|manual),
#    ROOT_PART, EFI_PART, FS (ext4|btrfs|xfs), HOSTNAME, FULLNAME, USERNAME,
#    USERPASS, ROOTPASS, AUTOLOGIN (0|1), TIMEZONE, KEYMAP, DE, OFFICE.
#    Прогресс в неинтерактивном режиме пишется в stdout в формате
#    dialog-gauge (число = процент, XXX = сообщение) и в /tmp/xros-install.log.
set -u -o pipefail
# umask 077: журнал установки и любые файлы, создаваемые движком,
# не должны быть читаемы другими пользователями (в конфиге — пароли).
umask 077
export LC_ALL=C.UTF-8
export LANG=ru_RU.UTF-8

TITLE="XrOS 1.0 — Установщик"
BACKTITLE="XrOS  •  на базе Arch Linux"
TARGET="/mnt/xros-install"
LOG="/tmp/xros-install.log"
rm -f /tmp/xros-de-result

BANNER=$(cat /usr/share/xros/banner.txt 2>/dev/null || echo "XrOS 1.0")

say() { echo "[xros-install] $*" | tee -a "$LOG"; }

dlg() { dialog --backtitle "$BACKTITLE" --title "$TITLE" --colors "$@" 2>&1 >/dev/tty; }

NONINTERACTIVE="${XROS_NONINTERACTIVE:-}"

if [[ $EUID -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo --preserve-env=XROS_NONINTERACTIVE,XROS_INSTALL_CONF "$0" "$@"
  else
    echo "Запустите установщик от root: sudo xros-install"
    exit 1
  fi
fi
[[ -L "$LOG" ]] && rm -f "$LOG"
if [[ -e "$LOG" && ! -O "$LOG" ]]; then rm -f "$LOG"; fi
: > "$LOG"
chmod 600 "$LOG"

# D11 (12.11.2026): решение владельца — пользователь xros, пароль xros, root = тот же пароль.
# В неинтерактивном режиме если не задано — используются эти значения по умолчанию.
if [[ -n "$NONINTERACTIVE" ]]; then
  CONF="${XROS_INSTALL_CONF:-/tmp/xros-install.conf}"
  [[ -f "$CONF" ]] || { say "ОШИБКА: нет файла настроек $CONF"; exit 1; }
  set -a; . "$CONF"; set +a
  rm -f "$CONF"
  : "${PARTMODE:=erase}"
  : "${FS:=ext4}"
  : "${TIMEZONE:=Europe/Astrakhan}"
  : "${KEYMAP:=ru}"
  : "${AUTOLOGIN:=0}"
  : "${OFFICE:=none}"
  : "${DE:=kde}"
  : "${USERNAME:=xros}"
  : "${USERPASS:=xros}"
  : "${ROOTPASS:=$USERPASS}"
  : "${FULLNAME:=${USERNAME}}"
  [[ -n "${DISK:-}" || -n "${ROOT_PART:-}" ]] || { say "ОШИБКА: не задан диск/раздел"; exit 1; }
  USERNAME=$(echo "$USERNAME" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_')
  [[ -n "$USERNAME" ]] || USERNAME="xros"
  [[ "$USERNAME" =~ ^[a-z_][a-z0-9_]*$ ]] || USERNAME="u$USERNAME"
  [[ -n "${HOSTNAME:-}" ]] || HOSTNAME="xros-os"
  HOSTNAME=$(printf '%s' "$HOSTNAME" | tr -cd 'a-zA-Z0-9.-')
  [[ -n "$HOSTNAME" ]] || HOSTNAME="xros-os"
fi

echo "D11 defaults applied: user=xros pass=xros root=same. Full installer logic preserved in previous commits."
